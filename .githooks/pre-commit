#!/bin/sh
branch=$(git rev-parse --abbrev-ref HEAD)
files=$(git diff --cached --name-only)
if [ -z "$files" ]; then exit 0; fi
case "$branch" in
  main)
    echo "HATA: main dalına doğrudan commit atılamaz. Kendi dalında (backend/frontend) çalış, GitHub'da Pull Request aç."; exit 1;;
  backend)
    allowed='^(supabase/|scripts/|docs/PROJE\.md$|docs/GIT-REHBERI\.md$|docs/SORU-EKLEME\.md$|docs/ENTEGRASYON\.md$|docs/YAYIN\.md$|docs/SUPABASE-KURULUM\.md$|docs/ISTEK-A-to-B\.md$|src/lib/api\.ts$|src/lib/scoring\.ts$|src/lib/scoring\.test\.ts$|src/types\.ts$|\.env\.example$|README\.md$)';;
  frontend)
    allowed='^(src/pages/|src/components/|src/hooks/|src/styles/|src/App\.tsx$|src/main\.tsx$|src/lib/client\.ts$|src/lib/api\.mock\.ts$|public/|index\.html$|vercel\.json$|docs/ISTEK-B-to-A\.md$)';;
  paket-*)
    allowed='^(package\.json|package-lock\.json)$';;
  *) exit 0;;
esac
bad=$(echo "$files" | grep -Ev "$allowed")
if [ -n "$bad" ]; then
  echo "HATA: '$branch' dalında şu dosyalar sana ait değil:"; echo "$bad"
  echo "Bunları commit etme. Gerekiyorsa diğer kişiye docs/ISTEK-*.md ile yaz."; exit 1
fi
